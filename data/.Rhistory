scales = "free_y",
labeller = labeller(Order.q = c("0" = "q = 0",
"1" = "q = 1",
"2" = "q = 2"))) +
scale_color_manual(values = c(
"Bacteria" = "#E64B35FF",
"Fungi" = "#4DBBD5FF",
"Eukaryote" = "#00A087FF"
)) +
labs(
x = "Site",
y = expression(q[D]~"(estimate ± 95% CI)"),
color = "Microbial group"
) +
theme_bw(base_size = 14, base_family = "Helvetica") +
theme(
panel.border = element_rect(color = "black", size = 0.6),
axis.title = element_text(size = 13, face = "bold"),
axis.text = element_text(size = 11),
strip.text = element_text(size = 12, face = "bold"),
legend.position = "right",
legend.title = element_text(size = 12, face = "bold"),
legend.text = element_text(size = 11)
)
library(readr)
water_quality <- read_csv("~/Desktop/qiime2_data/Library_A/dataset_20250909/Github/data/environmental_data/water_quality.csv")
View(water_quality)
setwd("~/Desktop/qiime2_data/Library_A/dataset_20250909/Github/data")
# ============================================================
# Load libraries
# ============================================================
library(tidyverse)
library(car)
library(emmeans)
# Set default ggplot theme
theme_set(theme_bw())
# ============================================================
# Load input data and
# ============================================================
dat <- read.csv("environmental_data/water_quality.csv", check.names = FALSE, stringsAsFactors = FALSE)
if ("δ13C" %in% names(dat)) dat <- dat %>% rename(d13C = `δ13C`)
if ("δ15N" %in% names(dat)) dat <- dat %>% rename(d15N = `δ15N`)
dat <- dat %>%
rename(
Date = Date,
Water_Depth = Water_Depth,
site = Area
)
# 日数に変換（Day_0 / Day_12 / Day_30）
dat <- dat %>%
mutate(
Date = factor(Date, levels = c("Day_0","Day_12","Day_30")),
day_num = case_when(
Date == "Day_0"  ~ 0,
Date == "Day_12" ~ 12,
Date == "Day_30" ~ 30,
TRUE ~ NA_real_
)
)
# ============================================================
# Statistical analysis
# ============================================================
# ==== 2) 時間加重平均（台形則）の関数 ====
twa_mean <- function(x, t){
# x: 数値ベクトル, t: 同じ長さの日数（数値）
# NA を落として並び替え
ok <- !(is.na(x) | is.na(t))
x <- x[ok]; t <- t[ok]
if (length(x) <= 1) return(NA_real_)
o <- order(t); x <- x[o]; t <- t[o]
if (length(x) == 2) return(mean(x))  # n=2 は単純平均と同じ
# 一般の台形則平均
dt <- diff(t)
auc <- sum( (head(x,-1) + tail(x,-1)) / 2 * dt )
auc / (max(t) - min(t))
}
# ==== 3) ユニット（site×depth）ごとの代表値を作成 ====
vars <- c("DOC","POC","HIX","BIX","TDN","TDP","d13C", "d15N")   # 必要に応じてd15Nも
env_unit <- dat %>%
group_by(site, Water_Depth) %>%
summarise(
across(all_of(vars),
~ twa_mean(.x, day_num), .names = "{.col}"),
# 参照用：各変数の有効測定回数（NA 除く）
across(all_of(vars),
~ sum(!is.na(.x)), .names = "n_{.col}"),
.groups = "drop"
)
# 代表値テーブルの確認
env_unit
# ==== 4) サイト間・深さ間の差を lm + Type III ANOVA で検定 ====
# 不均衡（site2 は surfaceのみ）に備えて type=3 を採用
run_anova <- function(response, data = env_unit){
f <- reformulate(c("site","Water_Depth"), response = response)
df <- data %>% select(all_of(c("site","Water_Depth", response))) %>% drop_na()
if (nrow(df) < 5) return(cat(response, ": not enough data\n"))
fit <- lm(f, data = df)
cat("\n=== ", response, " ===\n")
print(Anova(fit, type = 3))
# 周辺平均（サイト効果）と多重比較
emm <- emmeans(fit, ~ site)
print(pairs(emm, adjust = "tukey"))
}
for(v in vars){
run_anova(v)
}
# ==== 5) 経時変化の確認用プロット（ざっくり） ====
# 例：DOC と d13C をサイト×深さで折れ線表示
plot_timeseries <- function(var){
# --- y 軸ラベルを変数に応じて切り替え ---
ylab_var <- switch(var,
"TN"  = expression(TN~"["*mu*g~L^{-1}*"]"),
"TP"  = expression(TP~"["*mu*g~L^{-1}*"]"),
"DOC" = expression(DOC~"["*mu*g~L^{-1}*"]"),
"POC" = expression(log[10]~"(POC)"~"["*mu*g~L^{-1}*"]"),
var
)
p <- ggplot(dat, aes(
x = day_num,
y = .data[[var]],
group = interaction(site, Water_Depth),
color = Water_Depth,
shape = as.factor(site)
)) +
geom_line(alpha = 0.7, size = 0.8) +
geom_point(size = 2.5) +
scale_x_continuous(breaks = c(0, 12, 30)) +
scale_color_manual(values = c(
"hyporheic 20cm water" = "#E64B35FF",
"hyporheic 5cm water"  = "#4DBBD5FF",
"surface water"        = "#00A087FF"
)) +
labs(x = "Day", y = ylab_var, color = "Depth", shape = "Site") +
theme_bw(base_size = 12) +
theme(
text = element_text(family = "Helvetica", size = 13),
axis.title = element_text(size = 14),
axis.text  = element_text(size = 12),
panel.border = element_rect(color = "black"),
aspect.ratio = 0.5,
plot.margin = margin(5, 5, 5, 15)  # ← 左マージン統一して揃える
)
# --- POCだけ log10 scale ---
if (var == "POC") {
p <- p + scale_y_log10(breaks = c(100, 300, 1000, 3000, 10000))
}
return(p)
}
# ---- プロット生成 ----
p1 <- plot_timeseries("d13C")
p2 <- plot_timeseries("d15N")
p3 <- plot_timeseries("HIX")
p4 <- plot_timeseries("BIX")
p5 <- plot_timeseries("POC")
p6 <- plot_timeseries("DOC")
p7 <- plot_timeseries("TDN")
p8 <- plot_timeseries("TDP")
library(patchwork)
# 空白パネル（plot_spacer の方が安定）
blank <- patchwork::plot_spacer()
# ---- 図の全体レイアウト ----
supp_fig <- (
(p1 | p2 | p3) /
(p4 | p5 | p6) /
(p7 | p8 | blank)
) +
plot_layout(
guides = "collect",
heights = c(1,1,1)
) &
theme(
legend.position = "right",
legend.justification = c("left", "center")
)
supp_fig
