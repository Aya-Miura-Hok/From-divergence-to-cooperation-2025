###Site全体γ（全基質プール、記述）
# Site単位でプールしたカウントを用意
pool_by_site <- function(ps){
sd <- data.frame(sample_data(ps)); sd$SampleID <- rownames(sd)
otu <- as(otu_table(ps), "matrix"); if(!taxa_are_rows(ps)) otu <- t(otu)
sp <- split(sd$SampleID, sd$Site)
setNames(lapply(sp, function(v){ rs <- rowSums(otu[,v,drop=FALSE]); rs[rs>0] }), names(sp))
}
glist_site <- pool_by_site(exp_kept)
# 観測カバレッジと共通SC*
sc_site <- iNEXT::DataInfo(glist_site, "abundance")$SC
sc_star <- pmin(min(sc_site, na.rm=TRUE), 0.999)
gamma_site <- iNEXT::estimateD(glist_site, q=c(0,1,2), datatype="abundance",
base="coverage", level=sc_star, nboot=300, conf=0.95) %>%
rename(Site=Assemblage)
library(dplyr)
library(tidyr)
library(ggplot2)
library(rstatix)   # kruskal_test, dunn_test, add_xy_position
library(ggpubr)    # stat_pvalue_manual, stat_compare_means
library(readr)
# ===== 1) データ読み込み =====
csv_file <- "alpha_siteSC_bySite_commonSC_long.csv"   # 保存場所に合わせて変更可
df <- read_csv(csv_file, show_col_types = FALSE)
# 並び順（任意）
# df$Site <- factor(df$Site, levels = c("1","2","3","4"))
# df$Type <- factor(df$Type, levels = c("leaf","sediment_5","sediment_20","tile_d","tile_l"))
# 解析する q を選択（q=1 が主）
q_show <- 1
dfq <- df %>% filter(Order.q == q_show)
# 少なくとも Type が2水準ある Site のみ対象
valid_sites <- dfq %>% distinct(Site, Type) %>%
count(Site, name = "n_types") %>%
filter(n_types >= 2) %>% pull(Site)
dfq <- dfq %>% filter(Site %in% valid_sites)
# ===== 2) 検定（Kruskal → Dunn, BH補正） =====
kw_tbl <- dfq %>%
dplyr::group_by(Site) %>%
rstatix::kruskal_test(qD ~ Type) %>%
dplyr::ungroup()
dunn_tbl <- dfq %>%
dplyr::group_by(Site) %>%
rstatix::dunn_test(qD ~ Type, p.adjust.method = "BH") %>%
rstatix::add_xy_position(x = "Type") %>%   # xmin/xmax/y.position を付与
dplyr::ungroup()
# 有意のみ。rstatix は p.adj.signif を既に持っているはず
dunn_sig <- dunn_tbl %>%
dplyr::filter(p.adj < 0.05)
###論文用figure###
dunn_sig_plot <- dunn_sig %>%
dplyr::ungroup() %>%
dplyr::filter(p.adj < 0.05)
p <- ggplot(dfq, aes(x = Type, y = qD, fill = Type)) +
geom_boxplot(outlier.shape = NA, width = 0.7) +
geom_jitter(width = 0.15, alpha = 0.6, size = 1.8) +
facet_wrap(~ Site, scales = "free_y") +
{ if (nrow(dunn_sig_plot) > 0)
ggpubr::stat_pvalue_manual(
dunn_sig_plot,
label        = "p.adj.signif",
y.position   = "y.position",
xmin         = "xmin",
xmax         = "xmax",
size         = 6,
inherit.aes  = FALSE
)
else NULL } +
theme_minimal(base_size = 15) +
theme(
legend.position = "none",
strip.text = element_text(face = "bold"),
axis.text.x = element_text(angle = 45, hjust = 1)
)
print(p)
p <- ggplot(dfq, aes(x = Type, y = qD, fill = Type)) +
geom_boxplot(outlier.shape = NA, width = 0.7) +
geom_jitter(width = 0.15, alpha = 0.6, size = 1.8) +
facet_wrap(~ Site, scales = "free_y") +
{ if (nrow(dunn_sig_plot) > 0)
ggpubr::stat_pvalue_manual(
dunn_sig_plot,
label       = "p.adj.signif",
y.position  = "y.position",
xmin        = "xmin",
xmax        = "xmax",
size        = 6,
inherit.aes = FALSE
)
else NULL } +
labs(
x = "Substrate",
y = "Shannon diversity"
) +
theme_minimal(base_size = 15, base_family = "Helvetica") +
theme(
legend.position = "none",
axis.title = element_text(
size = 18,
face = "bold"
),
axis.text = element_text(
size = 12
),
axis.text.x = element_text(
angle = 45,
hjust = 1
),
strip.text = element_text(
size = 16,
face = "bold"
)
)
print(p)
