"Negative" = "#5A6FAE"   # 落ち着いた青紫
)) +
geom_text(
aes(label = paste0(round(percent), "%")),
position = position_stack(vjust = 0.5),
size = 3.2,
color = "white",
family = "Helvetica",
fontface = "bold"
) +
theme_void(base_family = "Helvetica") +
theme(
strip.text.x = element_text(size = 11, face = "bold"),   # Categoryラベル
strip.text.y = element_text(size = 11, face = "bold"),   # Siteラベル
legend.position = "right",
legend.title = element_blank(),
legend.text = element_text(size = 11),
plot.title = element_text(hjust = 0.5, size = 15, face = "bold")
)
}
# -----------------------------------------
# 図の作成
# -----------------------------------------
p_dom <- plot_donut(df_dom_long, group_cols = c("Site","Category")) +
labs(y = "Site") +  # ← 縦軸タイトルを追加
theme(
strip.placement = "outside",      # ← ファセットラベルを外側に配置
strip.text.y.left = element_text(angle = 0, hjust = 1, size = 12, face = "bold"),  # ← 左側タイトル風に
strip.switch.pad.grid = unit(0.2, "cm")
) +
facet_grid(Site ~ Category, switch = "y")   # ← y軸（左側）にタイトル配置を許可
p_dom
